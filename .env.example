# ============================================================
# OJS — Banco de Dados
# ============================================================
OJS_DB_HOST=db
OJS_DB_NAME=ojs
OJS_DB_USER=ojs
OJS_DB_PASSWORD=ojs

# ============================================================
# MariaDB (usado pelo serviço db no docker-compose)
# ============================================================
MARIADB_DATABASE=ojs
MARIADB_USER=ojs
MARIADB_PASSWORD=ojs
MARIADB_ROOT_PASSWORD=root

# ============================================================
# OJS — Configurações Gerais
# ============================================================
# Gere com: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
OJS_APP_KEY=base64:CHANGE_ME

OJS_BASE_URL=http://localhost:8080
OJS_TIME_ZONE=America/Sao_Paulo

# Off na primeira instalação; On depois que o OJS já foi instalado
OJS_INSTALLED=Off

# ============================================================
# OJS — Segurança
# ============================================================
# Gere valores aleatórios e únicos para cada ambiente
OJS_SALT=CHANGE_ME_random_secret_salt
OJS_API_KEY_SECRET=CHANGE_ME_random_api_key_secret

# ============================================================
# OJS — E-mail (SMTP)
# Deixe em branco para usar o driver "log" em desenvolvimento
# ============================================================
OJS_EMAIL_DEFAULT=log
# OJS_SMTP_SERVER=smtp.example.com
# OJS_SMTP_PORT=587
# OJS_SMTP_AUTH=tls
# OJS_SMTP_USERNAME=user@example.com
# OJS_SMTP_PASSWORD=secret
