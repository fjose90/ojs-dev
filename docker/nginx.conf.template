# Limite de requisições — proteção básica contra abuso
limit_req_zone $binary_remote_addr zone=ojs_limit:10m rate=${NGINX_RATE_LIMIT};

server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};
    root /var/www/html;
    index index.php;

    client_max_body_size ${NGINX_MAX_BODY_SIZE};

    # Gzip — reduz tamanho das respostas
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
    gzip_min_length 1024;

    # Headers de segurança
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Arquivos estáticos servidos diretamente pelo nginx
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|map)$ {
        expires max;
        log_not_found off;
        access_log off;
    }

    # Roteamento principal do OJS
    location / {
        limit_req zone=ojs_limit burst=20 nodelay;
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Passa requisições PHP para o PHP-FPM
    # Usa ^/index\.php para capturar PATH_INFO (ex: /index.php/journal/css?name=stylesheet)
    location ~ ^/index\.php {
        fastcgi_split_path_info ^(/index\.php)(/.+)$;
        fastcgi_pass app:9000;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_param PATH_TRANSLATED $document_root$fastcgi_path_info;
        include fastcgi_params;

        fastcgi_read_timeout ${NGINX_FASTCGI_TIMEOUT};
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
    }

    # Bloqueia acesso a arquivos sensíveis
    location ~ /\. {
        deny all;
    }

    location ~ \.(inc|conf)$ {
        deny all;
    }
}
